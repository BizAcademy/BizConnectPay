<%
  var ctEsc = function (v) { return String(v == null ? '' : v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); };
  var ctTrim = function (v) { return String(v == null ? '' : v).trim(); };
  var ctMailOk = function (e) { return /^[^\s@<>"']+@[^\s@<>"']+\.[^\s@<>"']+$/.test(e); };
  var ctSupport = ctTrim(s.support_email), ctLegal = ctTrim(s.legal_email);
  var ctEmails = [];
  if (ctSupport && ctMailOk(ctSupport)) ctEmails.push({ v: ctSupport, k: ctLegal && ctLegal.toLowerCase() !== ctSupport.toLowerCase() ? 'Support' : 'E-mail' });
  if (ctLegal && ctMailOk(ctLegal) && (!ctSupport || ctLegal.toLowerCase() !== ctSupport.toLowerCase())) ctEmails.push({ v: ctLegal, k: ctSupport ? 'Questions légales' : 'E-mail' });
  var ctPhone = ctTrim(s.legal_phone);
  var ctTel = ctPhone.replace(/[^\d+]/g, '').replace(/(?!^)\+/g, '');
  if (ctTel.replace(/\D/g, '').length < 6) ctTel = '';
  var ctWa = /^https?:\/\//i.test(String(waHref || '')) ? waHref : '';
  var ctAddr = ctTrim(s.legal_address);
  var ctCompany = ctTrim(s.legal_company);
  var ctAny = !!(ctEmails.length || ctTel || ctWa || ctAddr);
  var ctIco = {
    mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6.5L12 13l8.5-6.5"/>',
    tel: '<rect x="7" y="2.5" width="10" height="19" rx="2"/><path d="M11 18h2"/>',
    wa: '<path d="M4 20l1.2-3.6A8 8 0 1 1 8 19z"/><path d="M9.5 9.5c0 2.5 2.5 5 5 5"/>',
    pin: '<path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.2"/>'
  };
%><section id="contact" class="pg"><main class="ct">
<header class="ct-hero ct-rv"><span class="ct-over">Contact</span><h1>Parlons de votre <span>activité.</span></h1><p>Une question sur l'encaissement, les envois, les liens de paiement ou les cartes virtuelles ? Écrivez à l'équipe <%= ctCompany || 'BizConnectPay' %> par le canal qui vous convient.</p></header>
<% if (ctAny) { %>
<ul class="ct-grid">
<% if (ctWa) { %><li class="ct-card ct-hi ct-rv"><span class="ct-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><%- ctIco.wa %></svg></span><small>WhatsApp</small><h2>Échanger par message</h2><a class="btn sm" href="<%= ctWa %>" target="_blank" rel="noopener noreferrer">Ouvrir WhatsApp <span class="ct-sr">(nouvel onglet)</span></a></li><% } %>
<% ctEmails.forEach(function (e) { %><li class="ct-card ct-rv"><span class="ct-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><%- ctIco.mail %></svg></span><small><%= e.k %></small><h2>Écrire un e-mail</h2><a class="ct-val" href="mailto:<%= e.v %>"><%= e.v %></a></li><% }) %>
<% if (ctTel) { %><li class="ct-card ct-rv"><span class="ct-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><%- ctIco.tel %></svg></span><small>Téléphone</small><h2>Nous appeler</h2><a class="ct-val" href="tel:<%= ctTel %>"><%= ctPhone %></a></li><% } %>
<% if (ctAddr) { %><li class="ct-card ct-rv"><span class="ct-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><%- ctIco.pin %></svg></span><small>Adresse</small><h2><%= ctCompany ? 'Siège' : 'Notre adresse' %></h2><address class="ct-val"><% if (ctCompany) { %><b><%= ctCompany %></b><br><% } %><%= ctAddr %></address></li><% } %>
</ul>
<% } else { %>
<div class="ct-empty ct-rv" role="status"><span class="ct-tag">Coordonnées à venir</span><h2>Nos canaux de contact seront publiés prochainement</h2><p>Aucune coordonnée publique n'est disponible pour le moment. En attendant, découvrez nos solutions et nos tarifs.</p><div class="hero-act"><a class="btn" href="#services">Découvrir nos services</a><a class="btn o" href="#tarifs">Voir les tarifs</a></div></div>
<% } %>
<div class="ct-topics ct-rv"><h2><%= ctAny ? "Vous pouvez nous écrire pour" : "Nos quatre solutions" %></h2><ul><li><b>IN</b>Encaisser par Mobile Money, carte ou portefeuille</li><li><b>OUT</b>Payer bénéficiaires, fournisseurs et équipes</li><li><b>Link</b>Créer et partager des liens de paiement</li><li><b>Virtual</b>Utiliser des cartes virtuelles</li></ul><p class="ct-more"><a href="#tarifs">Voir les tarifs <span aria-hidden="true">&rarr;</span></a><a href="#services">Nos services <span aria-hidden="true">&rarr;</span></a></p></div>
</main></section>
