  };
  var contactCountries = Array.isArray(locals.contactCountries) ? locals.contactCountries : [];
  var L = { contactCountries: contactCountries, basePath: basePath, theme: theme, media: media, pricingHtml: pricingHtml, s: s, signupHref: signupHref, waHref: waHref, ph: ph, t: t, lang: lang, uiTranslations: uiTranslations };
