<%
  var s = locals.settings || {};
  var lang = locals.lang === 'en' ? 'en' : 'fr';
  var uiTranslations = locals.uiTranslations || {};
  var t = locals.t || function (v, p) { var out = String(v == null ? '' : v); if (p) out = out.replace(/\{(\w+)\}/g, function (m, k) { return Object.prototype.hasOwnProperty.call(p, k) ? String(p[k]) : m; }); return out; };
  var basePath = locals.basePath || '';
  var theme = locals.theme || '';
  var media = locals.media || {};
  var pricingHtml = locals.pricingHtml || '';
  var signupHref = s.signup_url || '#';
  var waDigits = String(s.whatsapp || '').replace(/[^0-9]/g, '');
  var waHref = /^https?:\/\//i.test(String(s.whatsapp || '')) ? s.whatsapp : (waDigits ? 'https://wa.me/' + waDigits : '');
  var _esc = function (v) { return String(v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); };
  var ph = function (key, label) {
    var v = s[key];
    if (key === 'legal_email' && !v) v = s.support_email;
    return v ? _esc(v) : '<span class="ph">' + _esc(t(label)) + '</span>';
  };
  var contactCountries = Array.isArray(locals.contactCountries) ? locals.contactCountries : [];
  var seo = locals.seo;
  var currentPage = locals.currentPage || 'accueil';
  var pagePaths = locals.pagePaths || {};
  var languagePaths = locals.languagePaths || {};
  // Keep the existing components, but emit real crawlable links on the server.
  var crawlableLinks = function (html) {
    return html.replace(/href="#([a-z]+)"/g, function (match, id) {
      return Object.prototype.hasOwnProperty.call(pagePaths, id) ? 'href="' + _esc(pagePaths[id]) + '"' : match;
    });
  };
  var L = { seo: seo, pricingT: locals.pricingT || t, contactCountries: contactCountries, basePath: basePath, theme: theme, media: media, pricingHtml: pricingHtml, s: s, signupHref: signupHref, waHref: waHref, ph: ph, t: t, lang: lang, uiTranslations: uiTranslations };
%><%- include('partials/head', L) %><body data-base-path="<%= basePath %>" data-page="<%= currentPage %>" data-page-paths="<%= JSON.stringify(pagePaths) %>" data-language-paths="<%= JSON.stringify(languagePaths) %>">
<%- crawlableLinks(include('partials/header', L)) %>

<%- crawlableLinks(include('pages/' + currentPage, L)).replace('class="pg"', 'class="pg on"') %>

<%- crawlableLinks(include('partials/footer', L)) %>
<script type="application/json" id="bcp-i18n"><%- JSON.stringify(uiTranslations).replace(/</g, '\\u003c') %></script><script src="<%= basePath %>/js/i18n.js?v=lang-2"></script><script src="<%= basePath %>/js/main.js?v=routes-1"></script><script src="<%= basePath %>/js/carousel.js?v=car-4"></script><script src="<%= basePath %>/js/country-picker.js?v=cp-2"></script><script src="<%= basePath %>/js/contact.js?v=ct-6"></script><script src="<%= basePath %>/js/header-menu.js?v=hm-3"></script></body></html>
