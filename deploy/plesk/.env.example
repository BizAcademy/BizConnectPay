# Ne jamais committer .env. À définir dans les variables de l'application Plesk.
NODE_ENV=production
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
SESSION_SECRET=
ADMIN_PASSWORD=

# Facultatifs : limites en Mo, proxy HTTPS, délais, préfixe URL.
IMAGE_MAX_MB=5
VIDEO_MAX_MB=50
SESSION_HOURS=8
TRUST_PROXY=1
BASE_PATH=/
# 1 = autorise l’aperçu public si MySQL est absent ou inaccessible.
# Sans connexion MySQL, administration, médias et newsletter restent indisponibles.
# Ne jamais activer sur le site en production.
SITE_PREVIEW=0
