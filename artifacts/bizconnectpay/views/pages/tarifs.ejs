<%
  var t = locals.pricingT || locals.t;
%><section id="tarifs" class="pg"><main class="px">
<header class="px-hero">
  <span class="px-over"><%= t("Dépôts · Retraits · Cartes Visa") %></span>
  <h1><%= t("Vos tarifs,") %> <span><%= t("en toute clarté.") %></span></h1>
  <p><%= t("Retrouvez les frais de dépôt, les frais de retrait et les prix de vos cartes Visa, réunis au même endroit.") %></p>
  <ul class="px-strip">
    <li><b>PAYIN</b><span><%= t("Dépôts") %></span></li>
    <li><b>PAYOUT</b><span><%= t("Retraits") %></span></li>
    <li><b>Visa</b><span><%= t("Cartes") %></span></li>
  </ul>
</header>

<div class="px-k" id="tarifs-grille"><%= t("Nos tarifs") %></div>
<h2><%= t("Trois tarifs simples à comprendre") %></h2>
<p class="px-lead"><%= t("Des pourcentages pour vos opérations et des prix distincts pour votre première carte et les suivantes.") %></p>

<div class="px-cards">
  <article class="px-card" aria-labelledby="payin-title">
    <small>PAYIN</small>
    <h3 id="payin-title"><%= t("Dépôts (PAYIN)") %></h3>
    <div class="px-price">5 %</div>
    <p><%= t("de frais par dépôt") %></p>
    <p class="px-description"><%= t("Ces frais s’appliquent à chaque opération de dépôt effectuée par un utilisateur.") %></p>
    <div class="px-example">
      <span class="px-example-label"><%= t("Exemple indicatif") %></span>
      <p><%= t("Pour un dépôt de") %> <strong>10 000 FCFA</strong></p>
      <div class="px-example-total"><span><%= t("Frais de dépôt") %></span><strong>500 FCFA</strong></div>
    </div>
  </article>

  <article class="px-card" aria-labelledby="payout-title">
    <small>PAYOUT</small>
    <h3 id="payout-title"><%= t("Retraits (PAYOUT)") %></h3>
    <div class="px-price"><%= lang === 'en' ? '3.5 %' : '3,5 %' %></div>
    <p><%= t("de frais par retrait") %></p>
    <p class="px-description"><%= t("Ces frais s’appliquent à chaque opération de retrait effectuée par un utilisateur.") %></p>
    <div class="px-example">
      <span class="px-example-label"><%= t("Exemple indicatif") %></span>
      <p><%= t("Pour un retrait de") %> <strong>10 000 FCFA</strong></p>
      <div class="px-example-total"><span><%= t("Frais de retrait") %></span><strong>350 FCFA</strong></div>
    </div>
  </article>

  <article class="px-card hi" aria-labelledby="visa-title">
    <small>VISA</small>
    <h3 id="visa-title"><%= t("Cartes Visa") %></h3>
    <div class="px-visa-first">
      <span class="px-visa-label"><%= t("Première carte Visa") %></span>
      <div class="px-price">2 000 <span class="px-currency">FCFA</span></div>
      <p><%= t("Équivalent indicatif : 3 USD") %></p>
    </div>
    <div class="px-visa-next">
      <span class="px-visa-label"><%= t("Chaque carte Visa supplémentaire") %></span>
      <div class="px-price">1 800 <span class="px-currency">FCFA</span></div>
    </div>
  </article>
</div>

<div class="px-cta">
  <h2><%= t("Une question sur ces tarifs ?") %></h2>
  <p><%= t("Notre équipe est à votre disposition pour vous renseigner sur les dépôts, les retraits et les cartes Visa.") %></p>
  <div class="hero-act"><a class="btn" href="#contact"><%= t("Contactez-nous") %></a></div>
</div>
</main></section>
