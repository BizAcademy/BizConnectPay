<%- include('partials/top', { title: 'Paramètres', eyebrow: 'Liens & informations légales' }) %>
<% var st = locals.settings || {}; var v = function (k) { return st[k] || ''; };
var groups = [
 ['Liens', 'Renseignez les URL de votre espace client. Dans l’en-tête, les boutons sans destination configurée restent désactivés ; la connexion client ne pointe pas vers le panneau admin.', [['login_url','Lien « Se connecter » / espace client','url','https://app.votre-domaine.com/connexion'],['signup_url','Lien « Commencer » / inscription','url','https://app.votre-domaine.com/inscription'],['support_email','E-mail support','email','support@bizconnectpay.com'],['whatsapp','WhatsApp (numéro international ou lien)','text','+225 07 00 00 00 00'],['linkedin_url','LinkedIn','url','https://linkedin.com/company/…'],['facebook_url','Facebook','url','https://facebook.com/…'],['x_url','X','url','https://x.com/…']]],
 ['Informations légales', 'Remplacent automatiquement les champs jaunes [À COMPLÉTER] des pages légales.', [['legal_company','Raison sociale','text',''],['legal_form','Forme juridique','text','SARL, SAS…'],['legal_address','Adresse du siège','text',''],['legal_registration','N° RCCM / NIF','text',''],['legal_director','Directeur de la publication','text',''],['legal_host','Hébergeur et adresse','text',''],['legal_country','Pays (droit applicable)','text',''],['legal_city','Ville (tribunaux compétents)','text',''],['legal_email','E-mail légal','email',''],['legal_phone','Téléphone','text','']]]
]; %>
<% groups.push(['Pied de page', 'Le lien vers la documentation est affiché uniquement lorsqu’il est renseigné.', [['api_docs_url', 'Lien vers la documentation API', 'url', 'https://docs.votre-domaine.com']]]); %>
<% groups.push(['Descriptions des images en anglais', 'Ces descriptions sont utilisées pour l’accessibilité sur la version anglaise. Sans description, un texte anglais générique est affiché.', (locals.slots || []).map(function(slot) { return [slot.key + '_alt_en', slot.label + ' — description anglaise', 'text', '']; })]); %>
<form method="post" action="<%= locals.basePath || '' %>/admin/settings" class="stack">
<input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
<% groups.forEach(function (g) { %>
<section class="panel"><h2><%= g[0] %></h2><p class="muted"><%= g[1] %></p><div class="fgrid">
<% g[2].forEach(function (f) { %><label class="fld"><span><%= f[1] %></span><input type="<%= f[2] %>" name="<%= f[0] %>" value="<%= v(f[0]) %>" placeholder="<%= f[3] %>" maxlength="500"></label><% }); %>
</div></section>
<% }); %>
<div class="row sticky"><button type="submit" class="btn" <%= locals.databaseAvailable === false ? 'disabled' : '' %>>Enregistrer les paramètres</button></div>
</form>
<%- include('partials/bottom') %>
