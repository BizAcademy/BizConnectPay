<% var _m = m; var _src = basePath + '/media/' + encodeURIComponent(_m.id); %><% if (_m.kind === 'video') { %><video class="bcp-media <%= cls || '' %>" src="<%= _src %>" controls muted playsinline preload="metadata"<% if (_m.alt) { %> aria-label="<%= _m.alt %>"<% } %><% if (style) { %> style="<%= style %>"<% } %>></video><% } else { %><img class="bcp-media <%= cls || '' %>" src="<%= _src %>" alt="<%= _m.alt || '' %>" loading="lazy"<% if (style) { %> style="<%= style %>"<% } %>><% } %>
